# Yerel veritabani (SQLite dosyasi: prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Platformun kendi adresleri (bunlar disindaki her adres bir klinik sitesi sayilir)
PLATFORM_HOSTS="localhost,127.0.0.1"
# Klinik alt alan adlari bu kok alan adinin altinda calisir: patidostu.localhost:3000
ROOT_DOMAIN="localhost"
# Hatirlatma mesajlarindaki linkler icin platform adresi
PUBLIC_URL="http://localhost:3000"

# Mesaj gonderimi: SIMULE (varsayilan, mesajlar panelde gorunur) | WHATSAPP_CLOUD
MESSAGE_PROVIDER="SIMULE"
# WhatsApp Business Cloud API (MESSAGE_PROVIDER=WHATSAPP_CLOUD ise)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Canlida zamanlanmis hatirlatma gorevi icin gizli anahtar (Vercel Cron)
CRON_SECRET=""
