{
  "name": "patipanel",
  "version": "1.0.0",
  "private": true,
  "description": "PatiPanel - veteriner klinikleri icin web sitesi, online randevu ve hatirlatma platformu",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:push": "prisma db push",
    "seed": "node prisma/seed.mjs",
    "reset": "prisma db push --force-reset && node prisma/seed.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.68.0",
    "next": "15.5.29",
    "qrcode": "^1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
